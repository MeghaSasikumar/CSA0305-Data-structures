#include <stdio.h>

#define INF 9999

int main() {
    int graph[10][10], selected[10] = {0};
    int n, i, j, edges = 0, min, x = 0, y = 0, cost = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter weighted adjacency matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    selected[0] = 1;

    printf("MST edges:\n");

    while (edges < n - 1) {
        min = INF;

        for (i = 0; i < n; i++) {
            if (selected[i]) {
                for (j = 0; j < n; j++) {
                    if (!selected[j] && graph[i][j] &&
                        graph[i][j] < min) {
                        min = graph[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        printf("%d - %d = %d\n", x, y, min);
        cost += min;
        selected[y] = 1;
        edges++;
    }

    printf("Minimum cost = %d", cost);

    return 0;
}
