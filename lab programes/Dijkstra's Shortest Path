#include <stdio.h>

#define INF 9999

int main() {
    int graph[10][10], dist[10], visited[10] = {0};
    int n, source, i, j, count, u, min;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter weighted adjacency matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Enter source vertex: ");
    scanf("%d", &source);

    for (i = 0; i < n; i++)
        dist[i] = graph[source][i] ? graph[source][i] : INF;

    dist[source] = 0;

    for (count = 0; count < n - 1; count++) {
        min = INF;
        u = -1;

        for (i = 0; i < n; i++) {
            if (!visited[i] && dist[i] < min) {
                min = dist[i];
                u = i;
            }
        }

        if (u == -1)
            break;

        visited[u] = 1;

        for (i = 0; i < n; i++) {
            if (!visited[i] && graph[u][i] &&
                dist[u] + graph[u][i] < dist[i])
                dist[i] = dist[u] + graph[u][i];
        }
    }

    printf("Shortest distances:\n");
    for (i = 0; i < n; i++)
        printf("%d to %d = %d\n", source, i, dist[i]);

    return 0;
}
